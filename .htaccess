AddDefaultCharset UTF-8
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --------------------------------------------------
    # Allow index.php
    <Files "index.php">
        Require all granted
    </Files>

    # --------------------------------------------------
    # Deny access to sensitive directories
    RedirectMatch 403 ^/(app|scheme|console|runtime)/

    # --------------------------------------------------
    # Deny access to sensitive files
    <FilesMatch "\.(env|json|xml|log|md|lock|git|ini|bak|sql)$">
        Require all denied
    </FilesMatch>

    # --------------------------------------------------
    # Prevent directory browsing
    Options -Indexes

    # --------------------------------------------------
    # Route all requests through public/index.php
    # Exclude any request that is already targeting the public folder,
    # whether the app is hosted at the domain root or inside a subdirectory.
    RewriteCond %{REQUEST_URI} !^/(?:.*?/)?public(?:/|$) [NC]
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
